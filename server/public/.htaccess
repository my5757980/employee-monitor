# Apache strips the Authorization header from the CGI/mod_php environment by
# default, so the agent's "Authorization: Bearer <token>" never reaches PHP.
# Re-expose it as HTTP_AUTHORIZATION (read by require_device() in src/http.php).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Belt and suspenders for Apache 2.4.13+ (mod_php honours this too).
<IfModule mod_php.c>
  CGIPassAuth On
  # A notice may carry a picture (6 MB) and a voice clip (12 MB), the limits index.php enforces.
  php_value upload_max_filesize 14M
  php_value post_max_size 20M
</IfModule>
